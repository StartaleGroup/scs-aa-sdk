{
  "name": "@startale-scs/aa-sdk",
  "version": "1.1.0",
  "author": "SCS",
  "repository": {
    "type": "git",
    "url": "github:StartaleLabs/scs-aa-sdk"
  },
  "main": "./dist/_cjs/index.js",
  "module": "./dist/_esm/index.js",
  "access": "public",
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.28.1",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@ethersproject/abi": "^5.8.0",
    "@ethersproject/providers": "^5.8.0",
    "@ethersproject/wallet": "^5.8.0",
    "@pimlico/alto": "^0.0.4",
    "@rhinestone/module-sdk": "^0.4.0",
    "@size-limit/esbuild-why": "^11.2.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/node": "^24.13.4",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-istanbul": "^3.0.7",
    "buffer": "^6.0.3",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "execa": "^9.5.2",
    "get-port": "^7.1.0",
    "gh-pages": "^6.3.0",
    "prool": "^0.0.23",
    "rimraf": "^6.0.1",
    "semver": "^7.7.2",
    "simple-git-hooks": "^2.11.1",
    "size-limit": "^11.2.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.11",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typedoc": "^0.27.9",
    "typescript": "^5.8.2",
    "viem": "^2.32.0",
    "vitest": "^3.0.7",
    "yargs": "^17.7.2"
  },
  "peerDependencies": {
  "@rhinestone/module-sdk": "^0.2.8 || ^0.3.0 || ^0.4.0",
  "typescript": "^5.8.2",
  "viem": ">=2.30.6"
  },
  "exports": {
    ".": {
      "types": "./dist/_types/index.d.ts",
      "import": "./dist/_esm/index.js",
      "require": "./dist/_cjs/index.js",
      "default": "./dist/_cjs/index.js"
    },
    "./smart-sessions": {
      "types": "./dist/_types/modules/validators/smartSessionsValidator/index.d.ts",
      "import": "./dist/_esm/modules/validators/smartSessionsValidator/index.js",
      "require": "./dist/_cjs/modules/validators/smartSessionsValidator/index.js",
      "default": "./dist/_cjs/modules/validators/smartSessionsValidator/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/_types/*"
      ],
      "smart-sessions": [
        "./dist/_types/modules/validators/smartSessionsValidator/index.d.ts"
      ]
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "description": "SDK for startale account integration with support for account abstraction, ERC-7579, ERC-4337.",
  "files": [
    "dist/*",
    "README.md"
  ],
  "homepage": "https://aa-docs.scs.startale.com/",
  "keywords": [
    "erc-7579",
    "modular smart account",
    "account abstraction",
    "scs",
    "sdk"
  ],
  "license": "MIT",
  "scripts": {
    "format": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "pnpm run lint --apply",
    "dev": "pnpm run build && concurrently \"pnpm run esm:watch\" \"pnpm run cjs:watch\" \"pnpm run esm:watch:aliases\" \"pnpm run cjs:watch:aliases\"",
    "build": "pnpm run clean && pnpm run build:cjs && pnpm run build:esm && pnpm run build:types",
    "prepack": "pnpm run build",
    "clean": "rimraf ./dist/_esm ./dist/_cjs ./dist/_types ./dist/tsconfig",
    "coverage": "vitest run -c ./src/test/vitest.config.ts --coverage",
    "test": "vitest run -c ./src/test/vitest.config.ts",
    "test:watch": "vitest --watch -c ./src/test/vitest.config.ts",
    "playground": "RUN_PLAYGROUND=true vitest -c ./src/test/vitest.config.ts -t=playground",
    "playground:watch": "RUN_PLAYGROUND=true pnpm run test -t=playground --watch",
    "fetch:tokenMap": "tsx scripts/fetch:tokenMap.ts && pnpm run lint:fix",
    "size": "size-limit",
    "docs": "typedoc --tsconfig ./tsconfig/tsconfig.esm.json",
    "docs:deploy": "pnpm run docs && gh-pages -d docs",
    "changeset": "changeset",
    "changeset:release": "changeset publish",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:release:canary": "original_name=$(tsx scripts/publish:canary.ts | grep ORIGINAL_NAME | cut -d'=' -f2) && npm publish && git checkout package.json && git tag -l '*-canary.*' | xargs git tag -d && git fetch --tags && git reset --hard && git clean -fd && echo \"Published canary version of $original_name as latest\"",
    "esm:watch": "tsc --project ./tsconfig/tsconfig.esm.json --watch",
    "cjs:watch": "tsc --project ./tsconfig/tsconfig.cjs.json --watch",
    "esm:watch:aliases": "tsc-alias -p ./tsconfig/tsconfig.esm.json --watch",
    "cjs:watch:aliases": "tsc-alias -p ./tsconfig/tsconfig.cjs.json --watch",
    "build:cjs": "tsc --project ./tsconfig/tsconfig.cjs.json && tsc-alias -p ./tsconfig/tsconfig.cjs.json && echo > ./dist/_cjs/package.json '{\"type\":\"commonjs\"}'",
    "build:esm": "tsc --project ./tsconfig/tsconfig.esm.json && tsc-alias -p ./tsconfig/tsconfig.esm.json && echo > ./dist/_esm/package.json '{\"type\": \"module\",\"sideEffects\":false}'",
    "build:types": "tsc --project ./tsconfig/tsconfig.types.json && tsc-alias -p ./tsconfig/tsconfig.types.json",
    "fetch:deployment": "tsx ./scripts/fetch:deployment.ts && pnpm run lint --apply-unsafe",
    "fetch:deployment:raw": "tsx ./scripts/fetch:deployment.ts",
    "fund:smartAccount": "tsx ./scripts/fund:smartAccount.ts"
  },
  "sideEffects": false,
  "simple-git-hooks": {
    "pre-commit": "pnpm run format && pnpm run lint:fix",
    "commit-msg": "npx --no -- commitlint --edit ${1}"
  },
  "type": "module",
  "types": "./dist/_types/index.d.ts",
  "typings": "./dist/_types/index.d.ts"
}
